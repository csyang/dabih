# .release.env
# Dabih — Local release configuration
#
# This file is gitignored. Each developer who performs releases configures
# their own share path here. Do not commit this file.
#
# Copy this file to .release.env and set NFS_RELEASE_PATH to the mounted
# network share directory where Dabih release files should be published.
# (Not needed for ./release.sh --dry-run.)
#
# Example (Linux/macOS NFS mount):
#   NFS_RELEASE_PATH=/mnt/nfs/releases/dabih
#
# Example (macOS automount):
#   NFS_RELEASE_PATH=/Volumes/Engineering/releases/dabih

NFS_RELEASE_PATH=/mnt/nfs/releases/dabih
