{
  // ── Test discovery ─────────────────────────────────────────────────────────
  // Runs the pytest suite from the Testing panel. tests/ read their input data
  // from examples/ via paths relative to the tests/ directory.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // ── Editor settings for Python ─────────────────────────────────────────────
  "[python]": {
    "editor.insertSpaces": true,
    "editor.tabSize":      4
  },

  // ── File associations ──────────────────────────────────────────────────────
  // Dabih emits SpyGlass .sgdc constraint files, which are Tcl-syntax.
  "files.associations": {
    "*.sv":   "systemverilog",
    "*.svh":  "systemverilog",
    "*.sgdc": "tcl"
  },

  // ── Explorer exclusions ────────────────────────────────────────────────────
  "files.exclude": {
    "dist":              true,
    "build":             true,
    "**/__pycache__":    true,
    "**/*.egg-info":     true,
    ".pytest_cache":     true
  },

  // ── Recommended extensions (shown to new developers) ───────────────────────
  "extensions.ignoreRecommendations": false
}
